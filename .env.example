# Copy to .env. Never commit .env.

# Vertex AI (Gemini via LiteLLM). Auth comes from `gcloud auth application-default login`
# locally and from the service account on Cloud Run.
VERTEXAI_PROJECT=your-gcp-project-id

# Web search for the News Researcher (https://tavily.com). Leave empty to disable news research.
TAVILY_API_KEY=

# Optional overrides
EADA_DB=data/eada.duckdb
# Cloud Run's filesystem is writable only under /tmp
CACHE_DIR=data/cache
